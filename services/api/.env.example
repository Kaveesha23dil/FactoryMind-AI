# FactoryMind AI backend configuration (copy to services/api/.env and fill in).
# Never commit the real .env file. Secrets stay on the backend only.

# --- Gemini / AI provider ---------------------------------------------------
# google = real Gemini via the Google Gen AI SDK + Google ADK (default)
# scripted = deterministic responses, for automated tests only
AI_PROVIDER=google

# Currently supported Gemini model, selected through configuration.
GEMINI_MODEL=gemini-2.5-flash

# Google AI Studio API key (local development).
GOOGLE_API_KEY=your_api_key_here

# AI investigation master switch.
AI_INVESTIGATION_ENABLED=true

# --- Vertex AI (optional, for Google Cloud deployments) ---------------------
# When using Vertex AI, leave GOOGLE_API_KEY unset and provide Application
# Default Credentials instead.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# --- Investigation controls -------------------------------------------------
FACTORYMIND_INVESTIGATION_TIMEOUT_SECONDS=90
FACTORYMIND_INVESTIGATION_MAX_RETRIES=1
FACTORYMIND_INVESTIGATION_MAX_HYPOTHESES=4
# true = background worker thread; false = run inline (tests/local debugging)
FACTORYMIND_INVESTIGATION_ASYNC=true
FACTORYMIND_KNOWLEDGE_TOP_K=5

# Optional shared secret enabling POST /api/investigations/{id}/process
# (the Cloud Tasks compatible worker entry point).
FACTORYMIND_WORKER_SECRET=

# --- Existing settings ------------------------------------------------------
FACTORYMIND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FACTORYMIND_LOG_LEVEL=INFO
# FACTORYMIND_DATASET_PATH=
# FACTORYMIND_DB_PATH=
